{
  "name": "motivo-stateflow-workspace",
  "private": true,
  "description": "Workspace for Motivo Stateflow: state machines, workflows and reliable execution.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm --filter motivo-stateflow run test:coverage",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "smoke": "pnpm --filter motivo-stateflow run smoke",
    "check": "pnpm run lint && pnpm run test && pnpm run test:coverage && pnpm run build && pnpm run smoke && pnpm run test:consumer"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.1",
    "typescript": "^5.9.2"
  }
}
